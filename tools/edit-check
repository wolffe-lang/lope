#!/usr/bin/env python3
"""edit-check — `lope edit` with an editor this tool writes (a script
that deletes one line, re-weighs one and adds one), how `$EDITOR` is
found (a path used as given; a name searched on PATH, passing over a file
that cannot be executed), and the refusals: an editor that fails, one
that is not there, and no `$EDITOR`, `$VISUAL` or `vi` at all (PAX's
case, ruling #91 R4).

    tools/edit-check LOPE        exit 0 when every row holds
"""
import os, shutil, subprocess, sys, tempfile, time

fails = 0


def say(ok, what):
    global fails
    print("edit-check: %s %s" % ("ok  " if ok else "FAIL", what))
    fails += not ok


def main():
    lope = os.path.abspath(sys.argv[1])
    d = os.path.realpath(tempfile.mkdtemp(prefix="lope-edit-"))
    try:
        for p in ("a", "b", "c", "bin", "tmp"):
            os.makedirs(os.path.join(d, p))
        now = int(time.time() * 1000)
        with open(os.path.join(d, "store"), "w") as f:
            f.write("lope-store 1\ncleanup %d\n" % now)
            f.write("3.000000 %d 3 %s/a\n" % (now - 2 * 86400000, d))
            f.write("1.000000 %d 1 %s/b\n" % (now - 2 * 86400000, d))
        ed = os.path.join(d, "bin", "fake-editor")
        with open(ed, "w") as f:
            f.write("#!/bin/sh\nset -e\nf=\"$1\"\n"
                    "grep -v '/b$' \"$f\" | sed 's#^3.000000 #8.500000 #' > \"$f.new\"\n"
                    "echo '2 %s/c' >> \"$f.new\"\nmv \"$f.new\" \"$f\"\n" % d)
        os.chmod(ed, 0o755)
        base = {"HOME": d, "LOPE_DATA_DIR": d, "TMPDIR": os.path.join(d, "tmp")}
        env = dict(base, PATH="/usr/bin:/bin", EDITOR=ed)
        p = subprocess.run([lope, "edit"], env=env, capture_output=True, text=True, stdin=subprocess.DEVNULL)
        say(p.returncode == 0 and p.stdout == "Database updated\n", "an edit is written back (%d %r %r)" % (p.returncode, p.stdout, p.stderr))
        text = open(os.path.join(d, "store")).read()
        say(("8.500000 %d 3 %s/a\n" % (now - 2 * 86400000, d)) in text, "a re-weighed path keeps its time and count")
        say("%s/b\n" % d not in text, "a deleted line forgets its directory")
        say(" 1 %s/c\n" % d in text and text.count("\n") == 4, "a new line enters with one visit now")
        say(os.listdir(os.path.join(d, "tmp")) == [], "the text file is removed")
        # an editor that exits 1, made here: `/bin/false` is not on every
        # host (macOS keeps it in /usr/bin only)
        bad = os.path.join(d, "bin", "failing-editor")
        with open(bad, "w") as f:
            f.write("#!/bin/sh\nexit 1\n")
        os.chmod(bad, 0o755)
        path = "%s:/usr/bin:/bin" % os.path.join(d, "bin")
        env = dict(base, PATH=path, EDITOR=bad)
        p = subprocess.run([lope, "edit"], env=env, capture_output=True, text=True, stdin=subprocess.DEVNULL)
        say(p.returncode == 1 and p.stderr == "lope: Editor exited with error\n", "an editor that fails, named by its path (%r)" % p.stderr)
        env = dict(base, PATH=path, EDITOR="failing-editor")
        p = subprocess.run([lope, "edit"], env=env, capture_output=True, text=True, stdin=subprocess.DEVNULL)
        say(p.returncode == 1 and p.stderr == "lope: Editor exited with error\n", "an editor that fails, found on PATH (%r)" % p.stderr)
        # a path is used as given, never searched for by its last part
        gone = os.path.join(d, "nowhere", "fake-editor")
        env = dict(base, PATH=path, EDITOR=gone)
        p = subprocess.run([lope, "edit"], env=env, capture_output=True, text=True, stdin=subprocess.DEVNULL)
        say(p.returncode == 1 and p.stderr == "lope: editor '%s' not found. Set $EDITOR or $VISUAL to an installed editor\n" % gone,
            "a path that is not there is not looked for on PATH (%r)" % p.stderr)
        # a name is searched on PATH as a shell searches: a file there that
        # cannot be executed is passed over for the next directory's
        shadow = os.path.join(d, "shadow")
        os.makedirs(shadow)
        with open(os.path.join(shadow, "fake-editor"), "w") as f:
            f.write("#!/bin/sh\nexit 7\n")
        os.chmod(os.path.join(shadow, "fake-editor"), 0o644)
        env = dict(base, PATH="%s:%s" % (shadow, path), EDITOR="fake-editor")
        p = subprocess.run([lope, "edit"], env=env, capture_output=True, text=True, stdin=subprocess.DEVNULL)
        say(p.returncode == 0 and p.stdout == "Database updated\n",
            "a file on PATH that cannot be executed is passed over (%d %r %r)" % (p.returncode, p.stdout, p.stderr))
        env = dict(base, PATH="/usr/bin:/bin", EDITOR="no-such-editor-xyz")
        p = subprocess.run([lope, "edit"], env=env, capture_output=True, text=True, stdin=subprocess.DEVNULL)
        say(p.returncode == 1 and p.stderr == "lope: editor 'no-such-editor-xyz' not found. Set $EDITOR or $VISUAL to an installed editor\n",
            "an editor that is not there (%r)" % p.stderr)
        env = dict(base, PATH=os.path.join(d, "bin"))
        p = subprocess.run([lope, "edit"], env=env, capture_output=True, text=True, stdin=subprocess.DEVNULL)
        say(p.returncode == 1 and p.stderr == "lope: editor 'vi' not found. Set $EDITOR or $VISUAL to an installed editor\n",
            "no $EDITOR, no $VISUAL, no vi (%r)" % p.stderr)
    finally:
        shutil.rmtree(d)
    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(main())
