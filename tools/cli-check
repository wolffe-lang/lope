#!/usr/bin/env python3
"""cli-check — lope held to gump's command line: every row of
tests/cli/expected.jsonl (what the gump binary answered, recorded by
tools/cli-record) run through lope in a fresh scratch directory, the
status, standard output and standard error compared byte for byte after
the substitutions lope makes on purpose:

  - the version: gump 0.2.7's `0.2.7` is lope's own (`lope 0.1.0`,
    `lope-query 0.1.0`);
  - the shells: lope's `init` takes pelt too, so `[possible values: bash,
    zsh, fish, fortsh]` reads `..., fortsh, pelt]`;
  - the rows tests/cli/differences.txt names (lope's hook text, which
    differs where README.md says): the status is compared, the text is
    not.

    tools/cli-check LOPE      exit 0 when every row agrees, 1 otherwise
"""
import json, os, re, shutil, subprocess, sys, tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
VERSION = "0.1.0"


def fix(s):
    s = re.sub(r"\b(lope(?:-[a-z]+)?) 0\.2\.7\b", r"\1 " + VERSION, s)
    return s.replace("[possible values: bash, zsh, fish, fortsh]", "[possible values: bash, zsh, fish, fortsh, pelt]")


def main():
    lope = os.path.abspath(sys.argv[1])
    differ = {}
    for line in open(os.path.join(ROOT, "tests/cli/differences.txt"), encoding="utf-8"):
        line = line.strip()
        if line and not line.startswith("#"):
            argv, why = line.split("\t", 1)
            differ[tuple(json.loads(argv))] = why
    rows = [json.loads(l) for l in open(os.path.join(ROOT, "tests/cli/expected.jsonl"), encoding="utf-8")]
    bad = 0
    by_design = 0
    for r in rows:
        d = tempfile.mkdtemp(prefix="lope-cli-")
        env = {"PATH": "/usr/bin:/bin", "HOME": d, "XDG_DATA_HOME": d + "/data", "LANG": "C.UTF-8", "EDITOR": "/bin/false"}
        p = subprocess.run([lope] + r["argv"], env=env, cwd=d, capture_output=True, text=True, stdin=subprocess.DEVNULL)
        out, err = p.stdout.replace(d, "$SCRATCH"), p.stderr.replace(d, "$SCRATCH")
        shutil.rmtree(d)
        key = tuple(r["argv"])
        if key in differ:
            by_design += 1
            if p.returncode != r["status"]:
                bad += 1
                print("cli-check: DIFFERS %s: status %d, gump %d" % (json.dumps(r["argv"]), p.returncode, r["status"]))
            continue
        want = (r["status"], fix(r["stdout"]), fix(r["stderr"]))
        if (p.returncode, out, err) != want:
            bad += 1
            print("cli-check: DIFFERS %s" % json.dumps(r["argv"]))
            print("  gump: %d %r %r" % want)
            print("  lope: %d %r %r" % (p.returncode, out, err))
    print("cli-check: %d of %d rows agree (%d by status only, by design)" % (len(rows) - bad, len(rows), by_design))
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
