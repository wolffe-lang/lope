#!/usr/bin/env python3
"""cli-record — run each command line of tests/cli/cases.txt through the
gump binary (gump.pin's commit, built from its tree) in a fresh scratch
directory, and write what it answered to tests/cli/expected.jsonl: the
status, standard output and standard error, with `gump` read as `lope`
and the scratch directory as `$SCRATCH`. Run on kasumi; tools/cli-check
replays the file against lope anywhere.

    tools/cli-record GUMP
"""
import json, os, shutil, subprocess, sys, tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def main():
    gump = os.path.abspath(sys.argv[1])
    rows = []
    for line in open(os.path.join(ROOT, "tests/cli/cases.txt"), encoding="utf-8"):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        argv = json.loads(line)
        d = tempfile.mkdtemp(prefix="lope-cli-")
        env = {"PATH": "/usr/bin:/bin", "HOME": d, "XDG_DATA_HOME": d + "/data", "LANG": "C.UTF-8", "EDITOR": "/bin/false"}
        r = subprocess.run([gump] + argv, env=env, cwd=d, capture_output=True, text=True, stdin=subprocess.DEVNULL)
        sub = lambda s: s.replace(d, "$SCRATCH").replace("gump", "lope")
        rows.append({"argv": argv, "status": r.returncode, "stdout": sub(r.stdout), "stderr": sub(r.stderr)})
        shutil.rmtree(d)
    with open(os.path.join(ROOT, "tests/cli/expected.jsonl"), "w", encoding="utf-8") as f:
        for r in rows:
            f.write(json.dumps(r, ensure_ascii=False) + "\n")
    print("cli-record: %d rows" % len(rows))


if __name__ == "__main__":
    main()
