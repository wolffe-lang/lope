#!/bin/sh
# build — compile lope on one tier or both.
#
# The program is `src/lope.lu` (marked `//! member: false`) over the
# modules under `src/` (`cli`, `db`, `matcher`, `cmd`, `out`), with the
# manifest `src/wolf.pkg` beside it. Usage:
#   tools/build [--native|--release|--all|--static]
#   --native   the fast default backend  -> target/native/lope
#   --release  LLVM with the mid-end on  -> target/release/lope
#   --all      both (the default)
#   --static   the release tier linked with `cc -static` (linux)
#                                        -> target/static/lope
#              the shape PAX runs (`pax/tools/mkpelt`'s): wolf has no
#              `--static`, so a `cc` that adds the flag is put first on
#              PATH for the link. Not part of --all. Build it on a
#              baseline x86-64 glibc (the CI runner's Ubuntu, an Ubuntu
#              container on kasumi), never on kasumi's CachyOS glibc.
# Every build denies warnings.
set -eu
LOPE_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export LOPE_ROOT
cd "$LOPE_ROOT"
. tools/lib-toolchain.sh

tiers="native release"
case "${1:-}" in
--native) tiers=native ;;
--release) tiers=release ;;
--all | "") ;;
--static) tiers=static ;;
*)
    echo "build: unknown option $1" >&2
    exit 2
    ;;
esac

for tier in $tiers; do
    mkdir -p "target/$tier"
    if [ "$tier" = static ]; then
        real=$(command -v cc)
        mkdir -p target/static/bin
        printf '#!/bin/sh\nexec %s -static "$@"\n' "$real" >target/static/bin/cc
        chmod +x target/static/bin/cc
        PATH="$LOPE_ROOT/target/static/bin:$PATH" \
            "$WOLF" build --release --no-cache --deny-warnings src/lope.lu -o target/static/lope
    elif [ "$tier" = release ]; then
        "$WOLF" build --release --deny-warnings src/lope.lu -o "target/$tier/lope"
    else
        "$WOLF" build --deny-warnings src/lope.lu -o "target/$tier/lope"
    fi
    echo "build: target/$tier/lope"
done
