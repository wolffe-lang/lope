#!/usr/bin/env python3
"""gen-fold — write src/matcher/fold.lu, the table that strips a Latin
letter's diacritics for an ASCII atom (docs/MATCHER.md, "Folding").

Derived from Unicode character NAMES, never from another matcher: every
code point in Latin-1 Supplement, Latin Extended-A, Latin Extended-B and
Latin Extended Additional whose name is "LATIN SMALL|CAPITAL LETTER X
WITH ..." (X one letter) folds to x. Nothing else folds: not SHARP S, not
AE, not DOTLESS I, not a turned or open letter (their names carry no
WITH). Runs of consecutive code points folding to one letter become one
range arm.

    tools/gen-fold          rewrite the table
    tools/gen-fold --check  exit 1 when the table in the tree differs
"""
import os, re, sys, unicodedata

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(ROOT, "src", "matcher", "fold.lu")
RANGES = [(0x00C0, 0x0250), (0x1E00, 0x1F00)]
NAME = re.compile(r"LATIN (SMALL|CAPITAL) LETTER ([A-Z]) WITH ")


def table():
    pairs = []
    for lo, hi in RANGES:
        for cp in range(lo, hi):
            m = NAME.match(unicodedata.name(chr(cp), ""))
            if m:
                pairs.append((cp, ord(m.group(2).lower())))
    arms, i = [], 0
    while i < len(pairs):
        j = i
        while j + 1 < len(pairs) and pairs[j + 1][0] == pairs[j][0] + 1 and pairs[j + 1][1] == pairs[i][1]:
            j += 1
        arms.append((pairs[i][0], pairs[j][0], pairs[i][1]))
        i = j + 1
    return pairs, arms


def render():
    pairs, arms = table()
    out = [
        "//! fold — a Latin letter with diacritics read as its base letter, for",
        "//! an ASCII atom (docs/MATCHER.md, \"Folding\"). GENERATED by",
        "//! tools/gen-fold from Unicode %s character names: %d code points in"
        % (unicodedata.unidata_version, len(pairs)),
        "//! %d arms. Do not edit by hand; `tools/gen-fold --check` is the gate." % len(arms),
        "",
        "/// `c` (a code point, already lowered) with its diacritics stripped when",
        "/// its Unicode name is a Latin letter WITH something; otherwise `c`.",
        "pub fn fold(c: int) -> int {",
        "    if c < 192 {",
        "        return c",
        "    }",
        "    match c {",
    ]
    for lo, hi, to in arms:
        if lo == hi:
            out.append("        %d => %d," % (lo, to))
        else:
            out.append("        %d..=%d => %d," % (lo, hi, to))
    out += ["        _ => c,", "    }", "}", ""]
    return "\n".join(out)


def main():
    text = render()
    if sys.argv[1:] == ["--check"]:
        have = open(OUT, encoding="utf-8").read() if os.path.exists(OUT) else ""
        if have != text:
            print("gen-fold: src/matcher/fold.lu differs from the generated table", file=sys.stderr)
            sys.exit(1)
        print("gen-fold: the table is the generated one")
        return
    with open(OUT, "w", encoding="utf-8") as f:
        f.write(text)
    print("gen-fold: wrote", OUT)


if __name__ == "__main__":
    main()
