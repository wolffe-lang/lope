#!/usr/bin/env python3
"""fold-check — which ASCII letter each non-ASCII letter answers to, lope
against the gump binary's record (tests/oracle/fold.jsonl: for 896 code
points of Latin-1, Latin Extended-A/B and Additional, Greek and Cyrillic,
the letters a..z whose one-letter query gump matched the path `/0/C`
with). lope's fold is its own (tools/gen-fold, from Unicode names); this
says where the two part, by class, and is held to the measured floor in
tests/oracle/FOLD-FLOOR.

    tools/fold-check LOPE
"""
import collections, json, os, shutil, subprocess, sys, tempfile, unicodedata

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def main():
    lope = os.path.abspath(sys.argv[1])
    rows = [json.loads(l) for l in open(os.path.join(ROOT, "tests/oracle/fold.jsonl"))]
    d = os.path.realpath(tempfile.mkdtemp(prefix="lope-fold-"))
    got = collections.defaultdict(str)
    try:
        with open(os.path.join(d, "store"), "w", encoding="utf-8") as f:
            f.write("lope-store 1\ncleanup 0\n")
            for r in rows:
                f.write("0.000000 0 1 /0/%s\n" % chr(r["cp"]))
        env = {"PATH": "/usr/bin:/bin", "HOME": d, "LOPE_DATA_DIR": d}
        for letter in "abcdefghijklmnopqrstuvwxyz":
            p = subprocess.run([lope, "query", "-a", "--", letter], env=env, cwd=d, capture_output=True, text=True)
            for line in p.stdout.splitlines():
                got[ord(line[3:])] += letter
    finally:
        shutil.rmtree(d)
    agree = 0
    classes = collections.Counter()
    for r in rows:
        have = got.get(r["cp"]) or None
        if have == r["gump"]:
            agree += 1
        else:
            name = unicodedata.name(chr(r["cp"]), "?")
            cls = "lope folds, gump does not" if have and not r["gump"] else (
                "gump folds, lope does not" if r["gump"] and not have else "both fold, to different letters")
            classes[(cls, name.split(" LETTER")[0])] += 1
    floor = float(open(os.path.join(ROOT, "tests/oracle/FOLD-FLOOR")).read().split()[0])
    rate = agree / len(rows)
    print("fold-check: %d of %d code points agree (%.2f%%), floor %.2f%%" % (agree, len(rows), 100 * rate, 100 * floor))
    for (cls, block), n in sorted(classes.items()):
        print("fold-check: %4d  %s  (%s)" % (n, cls, block))
    return 0 if rate >= floor else 1


if __name__ == "__main__":
    sys.exit(main())
