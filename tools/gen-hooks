#!/usr/bin/env python3
"""gen-hooks — write src/cmd/pieces.lu, the shell text `lope init` prints,
from the templates under shell/ (one file per piece; `@CMD@` is the jump
command's name). The templates are the source of truth: gump's
`src/cmd/init.rs` texts renamed (shell/*/ at the first commit), then
lope's changes, each commented where it is.

    tools/gen-hooks          rewrite src/cmd/pieces.lu
    tools/gen-hooks --check  exit 1 when the file in the tree differs
"""
import os, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(ROOT, "src", "cmd", "pieces.lu")


def lit(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"').replace("{", "{{").replace("}", "}}").replace("\n", "\\n") + '"'


def render():
    names = []
    for sh in sorted(os.listdir(os.path.join(ROOT, "shell"))):
        d = os.path.join(ROOT, "shell", sh)
        for f in sorted(os.listdir(d)):
            if f.endswith(".sh"):
                names.append((sh, f[:-3], open(os.path.join(d, f), encoding="utf-8").read()))
    out = [
        "//! pieces — the shell text `lope init` prints, one piece per template",
        "//! under shell/. GENERATED by tools/gen-hooks; do not edit by hand",
        "//! (`tools/gen-hooks --check` is the gate).",
        "",
        "/// The template `shell/SHELL/NAME.sh`, or \"\" when there is none.",
        "pub fn piece(shell: str, name: str) -> str {",
    ]
    for sh, n, text in names:
        out.append('    if shell == "%s" && name == "%s" {' % (sh, n))
        out.append("        return " + lit(text))
        out.append("    }")
    out += ['    ""', "}", ""]
    return "\n".join(out)


def main():
    text = render()
    if sys.argv[1:] == ["--check"]:
        have = open(OUT, encoding="utf-8").read() if os.path.exists(OUT) else ""
        if have != text:
            print("gen-hooks: src/cmd/pieces.lu differs from shell/; run tools/gen-hooks", file=sys.stderr)
            sys.exit(1)
        print("gen-hooks: src/cmd/pieces.lu is the generated one")
        return
    open(OUT, "w", encoding="utf-8").write(text)
    print("gen-hooks: wrote", OUT)


if __name__ == "__main__":
    main()
