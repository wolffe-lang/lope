//! pieces — the shell text `lope init` prints, one piece per template
//! under shell/. GENERATED by tools/gen-hooks; do not edit by hand
//! (`tools/gen-hooks --check` is the gate).

/// The template `shell/SHELL/NAME.sh`, or "" when there is none.
pub fn piece(shell: str, name: str) -> str {
    if shell == "bash" && name == "cmd" {
        return "\n# Jump function\n@CMD@() {{\n    if [[ $# -eq 0 ]]; then\n        builtin cd ~ && __lope_hook\n    elif [[ $# -eq 1 && \"$1\" == \"-\" ]]; then\n        builtin cd - && __lope_hook\n    elif [[ $# -eq 1 && -d \"$1\" ]]; then\n        # Explicit path - cd directly without fuzzy matching\n        builtin cd -- \"$1\" && __lope_hook\n    else\n        local result\n        # Try CWD first, then database\n        result=$(command lope query --cwd -- \"$@\" 2>/dev/null)\n        if [[ -z \"$result\" ]]; then\n            result=$(command lope query -- \"$@\" 2>/dev/null)\n        fi\n        if [[ -n \"$result\" ]]; then\n            builtin cd -- \"$result\" && __lope_hook\n        else\n            echo \"lope: no match found\" >&2\n            return 1\n        fi\n    fi\n}}\n\n# Interactive mode: fzf when it is installed, else a numbered menu\n@CMD@i() {{\n    local result\n    if command -v fzf >/dev/null 2>&1; then\n        result=$(command lope query --all -- \"$@\" | fzf --height=40% --reverse)\n    else\n        result=$(__lope_menu \"$@\")\n    fi\n    if [[ -n \"$result\" ]]; then\n        builtin cd -- \"$result\" && __lope_hook\n    fi\n}}\n"
    }
    if shell == "bash" && name == "hook" {
        return "\n# lope hook - called after directory changes\n__lope_hook() {{\n    __lope_oldpwd=\"$PWD\"\n    command lope add -- \"$PWD\"\n}}\n"
    }
    if shell == "bash" && name == "jump" {
        return "\n# No-prefix directory jumping. bash runs command_not_found_handle in a\n# subshell, where a cd cannot reach the shell (gump's hook stays put), so\n# lope reads the line when Enter is pressed instead, as the zsh and fish\n# hooks do: a first word that is no alias, keyword, function, built-in or\n# command, and is a directory here or matches one, becomes `cd -- DIR`\n# before bash reads the line. bash 4 or later, interactive.\n__lope_accept_line() {{\n    local -a words\n    read -r -a words <<<\"$READLINE_LINE\"\n    local first=\"${{words[0]}}\"\n    [[ -z \"$first\" ]] && return 0\n    [[ \"$first\" == [./~]* ]] && return 0\n    type -t -- \"$first\" >/dev/null 2>&1 && return 0\n    local result\n    if [[ -d \"$first\" ]]; then\n        result=\"$first\"\n    else\n        result=$(command lope query --cwd -- \"${{words[@]}}\" 2>/dev/null)\n        if [[ -z \"$result\" ]]; then\n            result=$(command lope query -- \"${{words[@]}}\" 2>/dev/null)\n        fi\n    fi\n    if [[ -n \"$result\" ]]; then\n        printf -v READLINE_LINE 'cd -- %q' \"$result\"\n        READLINE_POINT=${{#READLINE_LINE}}\n    fi\n}}\n\nif [[ $- == *i* ]] && ((BASH_VERSINFO[0] >= 4)); then\n    for __lope_map in emacs vi-insert vi-command; do\n        bind -m \"$__lope_map\" -x '\"\\C-x\\C-_\": __lope_accept_line'\n        bind -m \"$__lope_map\" '\"\\C-x\\C-^\": accept-line'\n        bind -m \"$__lope_map\" '\"\\C-m\": \"\\C-x\\C-_\\C-x\\C-^\"'\n        bind -m \"$__lope_map\" '\"\\C-j\": \"\\C-x\\C-_\\C-x\\C-^\"'\n    done\n    unset __lope_map\nfi\n"
    }
    if shell == "bash" && name == "prompt" {
        return "\n# Update on every prompt\nif [[ \"${{PROMPT_COMMAND:-}}\" != *'__lope_hook'* ]]; then\n    PROMPT_COMMAND=\"__lope_hook;${{PROMPT_COMMAND#;}}\"\nfi\n"
    }
    if shell == "bash" && name == "pwd" {
        return "\n# Update when directory changes\n__lope_oldpwd=\"$PWD\"\n__lope_pwd_hook() {{\n    if [[ \"$PWD\" != \"$__lope_oldpwd\" ]]; then\n        __lope_oldpwd=\"$PWD\"\n        __lope_hook\n    fi\n}}\nif [[ \"${{PROMPT_COMMAND:-}}\" != *'__lope_pwd_hook'* ]]; then\n    PROMPT_COMMAND=\"__lope_pwd_hook;${{PROMPT_COMMAND#;}}\"\nfi\n"
    }
    if shell == "fish" && name == "cmd" {
        return "\n# Jump function\nfunction @CMD@ --description \"Jump to a directory\"\n    if test (count $argv) -eq 0\n        cd ~\n    else if test (count $argv) -eq 1 -a \"$argv[1]\" = \"-\"\n        cd -\n    else if test (count $argv) -eq 1 -a -d \"$argv[1]\"\n        # Explicit path - cd directly without fuzzy matching\n        cd $argv[1]\n    else\n        # Try CWD first, then database\n        set -l result (command lope query --cwd -- $argv 2>/dev/null)\n        if test -z \"$result\"\n            set result (command lope query -- $argv 2>/dev/null)\n        end\n        if test -n \"$result\"\n            cd $result\n        else\n            echo \"lope: no match found\" >&2\n            return 1\n        end\n    end\nend\n\n# Interactive mode: fzf when it is installed, else a numbered menu\nfunction @CMD@i --description \"Jump to a directory (interactive)\"\n    if type -q fzf\n        set -l result (command lope query --all -- $argv | fzf --height=40% --reverse)\n        if test -n \"$result\"\n            cd $result\n        end\n        return\n    end\n    set -l all (command lope query --all -- $argv)\n    or return 1\n    set -l n (count $all)\n    if test $n -gt 9\n        set n 9\n    end\n    for i in (seq $n)\n        printf '%s) %s\\n' $i $all[$i] >&2\n    end\n    set -g __lope_reading 1\n    read -P \"lope: which (1-$n)? \" -l pick\n    set -l st $status\n    set -e __lope_reading\n    test $st -eq 0\n    or return 1\n    if string match -qr '^[1-9]$' -- \"$pick\"; and test $pick -le $n\n        cd $all[$pick]\n    else\n        return 1\n    end\nend\n"
    }
    if shell == "fish" && name == "jump" {
        return "\n# No-prefix directory jumping via Enter key interception\nfunction __lope_execute\n    # Enter inside `read` is that read's own answer, never a command line\n    # to rewrite: gi's menu says it is reading; a `read` typed at the\n    # prompt is the current command\n    if set -q __lope_reading; or test (status current-command) = read\n        commandline -f execute\n        return\n    end\n\n    set -l cmd (commandline -b)\n    set -l first_word (string split ' ' -- $cmd)[1]\n\n    # Skip if empty\n    if test -z \"$first_word\"\n        commandline -f execute\n        return\n    end\n\n    # Skip if command exists\n    if type -q \"$first_word\"\n        commandline -f execute\n        return\n    end\n\n    # Skip if starts with path characters\n    if string match -qr '^[./~]' -- \"$first_word\"\n        commandline -f execute\n        return\n    end\n\n    # Check if it's a local directory (exact match)\n    if test -d \"$first_word\"\n        commandline -r \"cd $first_word\"\n        commandline -f execute\n        return\n    end\n\n    # Fuzzy match against current directory contents\n    set -l result (command lope query --cwd -- $cmd 2>/dev/null)\n    if test -n \"$result\"\n        commandline -r \"cd \\\"$result\\\"\"\n        commandline -f execute\n        return\n    end\n\n    # Query lope database\n    set -l result (command lope query -- $cmd 2>/dev/null)\n    if test -n \"$result\"\n        commandline -r \"cd \\\"$result\\\"\"\n        commandline -f execute\n        return\n    end\n\n    # Not a lope match, execute normally\n    commandline -f execute\nend\n\nbind \\r __lope_execute\nbind \\n __lope_execute\n"
    }
    if shell == "fish" && name == "prompt" {
        return "\n# Update on every prompt\nfunction __lope_hook --on-event fish_prompt\n    command lope add -- $PWD\nend\n"
    }
    if shell == "fish" && name == "pwd" {
        return "\n# Update when directory changes\nfunction __lope_hook --on-variable PWD\n    command lope add -- $PWD\nend\n"
    }
    if shell == "fortsh" && name == "cmd" {
        return "\n# Jump function\n@CMD@() {{\n    if [[ $# -eq 0 ]]; then\n        command cd ~ && __lope_hook\n    elif [[ $# -eq 1 && \"$1\" == \"-\" ]]; then\n        command cd - && __lope_hook\n    elif [ $# -eq 1 ] && [ -d \"$1\" ]; then\n        command cd \"$1\" && __lope_hook\n    else\n        local result\n        result=$(command lope query --cwd -- \"$@\" 2>/dev/null)\n        if [[ -z \"$result\" ]]; then\n            result=$(command lope query -- \"$@\" 2>/dev/null)\n        fi\n        if [[ -n \"$result\" ]]; then\n            command cd \"$result\" && __lope_hook\n        else\n            echo \"lope: no match found\" >&2\n            return 1\n        fi\n    fi\n}}\n\n# Interactive mode: fzf when it is installed, else a numbered menu\n@CMD@i() {{\n    local result\n    if command -v fzf >/dev/null 2>&1; then\n        result=$(command lope query --all -- \"$@\" | fzf --height=40% --reverse)\n    else\n        result=$(__lope_menu \"$@\")\n    fi\n    if [[ -n \"$result\" ]]; then\n        command cd \"$result\" && __lope_hook\n    fi\n}}\n"
    }
    if shell == "fortsh" && name == "hook" {
        return "\n# lope hook - called after directory changes\n__lope_hook() {{\n    __lope_oldpwd=\"$PWD\"\n    command lope add -- \"$PWD\"\n}}\n"
    }
    if shell == "fortsh" && name == "jump" {
        return "\n# No-prefix directory jumping\ncommand_not_found_handle() {{\n    # Check if it's a local directory first (exact match)\n    if [ -d \"$1\" ]; then\n        command cd \"$1\" && __lope_hook\n        return 0\n    fi\n\n    # Fuzzy match against current directory contents\n    local result\n    result=$(command lope query --cwd -- \"$@\" 2>/dev/null)\n    if [[ -n \"$result\" ]]; then\n        command cd \"$result\" && __lope_hook\n        return 0\n    fi\n\n    # Query lope database\n    result=$(command lope query -- \"$@\" 2>/dev/null)\n    if [[ -n \"$result\" ]]; then\n        command cd \"$result\" && __lope_hook\n        return 0\n    fi\n\n    # Fallback to default \"command not found\" behavior\n    echo \"fortsh: $1: command not found\" >&2\n    return 127\n}}\n"
    }
    if shell == "fortsh" && name == "pwd" {
        return "\n# Track directory changes\n__lope_oldpwd=\"$PWD\"\n__lope_pwd_hook() {{\n    if [[ \"$PWD\" != \"$__lope_oldpwd\" ]]; then\n        __lope_oldpwd=\"$PWD\"\n        __lope_hook\n    fi\n}}\n"
    }
    if shell == "fortsh" && name == "trap-prompt" {
        return "\n# Update on every prompt (via DEBUG trap)\ntrap '__lope_hook' DEBUG\n"
    }
    if shell == "fortsh" && name == "trap-pwd" {
        return "\n# Update when directory changes (via DEBUG trap)\ntrap '__lope_pwd_hook' DEBUG\n"
    }
    if shell == "pelt" && name == "cmd" {
        return "\n# Jump function\n@CMD@() {{\n    if [ $# -eq 0 ]; then\n        command cd ~ && __lope_hook\n    elif [ $# -eq 1 ] && [ \"$1\" = \"-\" ]; then\n        command cd - && __lope_hook\n    elif [ $# -eq 1 ] && [ -d \"$1\" ]; then\n        command cd -- \"$1\" && __lope_hook\n    else\n        __lope_result=$(command lope query --cwd -- \"$@\" 2>/dev/null)\n        if [ -z \"$__lope_result\" ]; then\n            __lope_result=$(command lope query -- \"$@\" 2>/dev/null)\n        fi\n        if [ -n \"$__lope_result\" ]; then\n            command cd -- \"$__lope_result\" && __lope_hook\n        else\n            echo \"lope: no match found\" >&2\n            return 1\n        fi\n    fi\n}}\n\n# Interactive mode: fzf when it is installed, else a numbered menu\n@CMD@i() {{\n    if command -v fzf >/dev/null 2>&1; then\n        __lope_result=$(command lope query --all -- \"$@\" | fzf --height=40% --reverse)\n    else\n        __lope_result=$(__lope_menu \"$@\")\n    fi\n    if [ -n \"$__lope_result\" ]; then\n        command cd -- \"$__lope_result\" && __lope_hook\n    fi\n}}\n"
    }
    if shell == "pelt" && name == "hook" {
        return "\n# lope hook - called after directory changes\n__lope_hook() {{\n    command lope add -- \"$PWD\"\n}}\n"
    }
    if shell == "pelt" && name == "jump" {
        return "\n# No-prefix directory jumping. pelt calls this function when a command is\n# not found (since sh21, pelt#43), in the shell's own environment, with\n# the command's words: it changes directory and answers 0, or answers 127\n# and pelt says what it always says (`NAME: not found`).\ncommand_not_found_handle() {{\n    if [ -d \"$1\" ]; then\n        command cd -- \"$1\" && __lope_hook\n        return 0\n    fi\n    __lope_result=$(command lope query --cwd -- \"$@\" 2>/dev/null)\n    if [ -z \"$__lope_result\" ]; then\n        __lope_result=$(command lope query -- \"$@\" 2>/dev/null)\n    fi\n    if [ -n \"$__lope_result\" ]; then\n        command cd -- \"$__lope_result\" && __lope_hook\n        return 0\n    fi\n    return 127\n}}\n"
    }
    if shell == "pelt" && name == "prompt" {
        return "\n# Update on every prompt: pelt expands PS1 before each prompt (XCU 2.5.3),\n# command substitutions included, so the hook runs there.\ncase ${{PS1-}} in\n*__lope_hook*) ;;\n*) PS1='$(__lope_hook)'\"${{PS1-\\$ }}\" ;;\nesac\n"
    }
    if shell == "pelt" && name == "pwd" {
        return "\n# Update when directory changes. pelt has no hook on a change of\n# directory, so `cd` is a function that records where it went (a function\n# is found before a regular built-in, POSIX XCU 2.9.1.4; `command cd` is\n# the built-in itself).\ncd() {{\n    command cd \"$@\" && __lope_hook\n}}\n"
    }
    if shell == "posix" && name == "menu" {
        return "\n# A numbered menu of the best matches, for when fzf is not installed (and\n# on PAX, which has none): at most nine, chosen by one digit read from the\n# terminal; the chosen directory is printed. Shell built-ins and lope only.\n__lope_menu() {{\n    command lope query --all -- \"$@\" >/dev/null 2>&1 || return 1\n    command lope query --all -- \"$@\" | {{\n        __lope_n=0\n        while [ \"$__lope_n\" -lt 9 ] && IFS= read -r __lope_line; do\n            __lope_n=$((__lope_n + 1))\n            printf '%s) %s\\n' \"$__lope_n\" \"$__lope_line\" >&2\n        done\n    }}\n    printf 'lope: which? ' >&2\n    read -r __lope_pick || return 1\n    # (`:` in the arm: fortsh 1.10.0 stops at an empty case arm)\n    case $__lope_pick in\n    [1-9]) : ;;\n    *) return 1 ;;\n    esac\n    command lope query --all -- \"$@\" | {{\n        __lope_n=0\n        while IFS= read -r __lope_line; do\n            __lope_n=$((__lope_n + 1))\n            if [ \"$__lope_n\" -eq \"$__lope_pick\" ]; then\n                printf '%s\\n' \"$__lope_line\"\n                break\n            fi\n        done\n    }}\n}}\n"
    }
    if shell == "zsh" && name == "cmd" {
        return "\n# Jump function\n@CMD@() {{\n    if [[ $# -eq 0 ]]; then\n        builtin cd ~\n    elif [[ $# -eq 1 && \"$1\" == \"-\" ]]; then\n        builtin cd -\n    elif [[ $# -eq 1 && -d \"$1\" ]]; then\n        # Explicit path - cd directly without fuzzy matching\n        builtin cd -- \"$1\"\n    else\n        local result\n        # Try CWD first, then database\n        result=$(command lope query --cwd -- \"$@\" 2>/dev/null)\n        if [[ -z \"$result\" ]]; then\n            result=$(command lope query -- \"$@\" 2>/dev/null)\n        fi\n        if [[ -n \"$result\" ]]; then\n            builtin cd -- \"$result\"\n        else\n            echo \"lope: no match found\" >&2\n            return 1\n        fi\n    fi\n}}\n\n# Interactive mode: fzf when it is installed, else a numbered menu\n@CMD@i() {{\n    local result\n    if command -v fzf >/dev/null 2>&1; then\n        result=$(command lope query --all -- \"$@\" | fzf --height=40% --reverse)\n    else\n        result=$(__lope_menu \"$@\")\n    fi\n    if [[ -n \"$result\" ]]; then\n        builtin cd -- \"$result\"\n    fi\n}}\n"
    }
    if shell == "zsh" && name == "hook" {
        return "\n# lope hook - called after directory changes\n__lope_hook() {{\n    command lope add -- \"$PWD\"\n}}\n"
    }
    if shell == "zsh" && name == "jump" {
        return "\n# ZLE widget to intercept commands before execution\n__lope_accept_line() {{\n    local first_word=\"${{BUFFER%% *}}\"\n\n    # Skip if buffer is empty\n    if [[ -z \"$BUFFER\" ]]; then\n        zle .accept-line\n        return\n    fi\n\n    # Skip paths (starting with . / or ~)\n    if [[ \"$first_word\" == \".\"* ]] || \\\n       [[ \"$first_word\" == \"/\"* ]] || \\\n       [[ \"$first_word\" == \"~\"* ]]; then\n        zle .accept-line\n        return\n    fi\n\n    # Skip if command exists (whence checks builtins, functions, aliases, and PATH)\n    if whence \"$first_word\" >/dev/null 2>&1; then\n        zle .accept-line\n        return\n    fi\n\n    # Check if it's a local directory (exact match)\n    if [[ -d \"$first_word\" ]]; then\n        BUFFER=\"cd ${{(q)first_word}}\"\n        zle .accept-line\n        return\n    fi\n\n    # Fuzzy match against current directory contents\n    local result\n    result=$(command lope query --cwd -- $=BUFFER 2>/dev/null)\n    if [[ -n \"$result\" ]]; then\n        BUFFER=\"cd ${{(q)result}}\"\n        zle .accept-line\n        return\n    fi\n\n    # Query lope database\n    result=$(command lope query -- $=BUFFER 2>/dev/null)\n    if [[ -n \"$result\" ]]; then\n        BUFFER=\"cd ${{(q)result}}\"\n    fi\n\n    zle .accept-line\n}}\n\nzle -N accept-line __lope_accept_line\n"
    }
    if shell == "zsh" && name == "prompt" {
        return "\n# Update on every prompt\n[[ -n \"${{precmd_functions[(r)__lope_hook]}}\" ]] || precmd_functions+=(__lope_hook)\n"
    }
    if shell == "zsh" && name == "pwd" {
        return "\n# Update when directory changes (chpwd hook)\n[[ -n \"${{chpwd_functions[(r)__lope_hook]}}\" ]] || chpwd_functions+=(__lope_hook)\n"
    }
    ""
}
