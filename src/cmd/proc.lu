//! proc — finding and running another program: `$EDITOR` for `edit`,
//! `zoxide` for `import`.

/// Whether `path` names a regular file someone may execute (any of its
/// execute bits set; links followed).
pub fn runnable(path: str) -> bool {
    let rec = fs_stat(path) else |_| {
        return false
    }
    rec[0] == 0 && rec[4] % 512 / 64 % 2 + rec[4] % 64 / 8 % 2 + rec[4] % 8 % 2 > 0
}

/// `name` found on `$PATH` as a shell finds a command: the first
/// directory holding a regular file of that name that may be executed (a
/// file that may not is passed over), or "" when none does. A name holding
/// a slash is taken as it is, and must be a file.
pub fn on_path(name: str) -> str {
    if name.len == 0 {
        return ""
    }
    if (name.find("/") else -1) >= 0 {
        return if fs_is_file(name) then name else ""
    }
    let path = env_get("PATH") else ""
    for dir in path.split(":") {
        let d = if dir.len == 0 then "." else dir
        let cand = if d.ends_with("/") then "{d}{name}" else "{d}/{name}"
        if runnable(cand) {
            return cand
        }
    }
    ""
}

/// What a child answered: its exit status (`status`, -1 when it could not
/// be started or was killed by a signal) and its standard output when it
/// was captured.
pub struct Ran {
    status: int,
    output: str,
}

/// Run `exe` with `args` on the terminal this process has (descriptors
/// 0, 1 and 2 handed down), and wait for it.
pub fn run_here(exe: str, args: List[str]) -> int {
    let h = os_spawn_fds(exe, args, [0, 0, 1, 1, 2, 2]) else |_| {
        return -1
    }
    os_wait(h) else -1
}

/// Run `exe` with `args`, its standard output read whole and its standard
/// error closed, and wait for it.
pub fn run_captured(exe: str, args: List[str]) -> Ran {
    let (r, w) = os_pipe() else |_| {
        return Ran { status: -1, output: "" }
    }
    let h = os_spawn_fds(exe, args, [1, w, 2, -1]) else |_| {
        fs_close(w) else |_| {}
        fs_close(r) else |_| {}
        return Ran { status: -1, output: "" }
    }
    fs_close(w) else |_| {}
    var bytes = List[byte]()
    loop {
        let chunk = fs_read_chunk(r, 65536) else |_| {
            break
        }
        for b in chunk {
            (mut bytes).push(b)
        }
    }
    fs_close(r) else |_| {}
    let st = os_wait(h) else -1
    let text = str_from_utf8(bytes) else ""
    Ran { status: st, output: text }
}
