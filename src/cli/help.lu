//! help — the help texts, as gump 0.2.7 prints them (clap 4's layout,
//! recorded by tools/cli-record into tests/cli/expected.jsonl), with
//! the name lope and `pelt` among the shells. `tools/cli-check` holds
//! every one to the recording.

/// The help text: the top level's (`lope --help`).
pub fn help_top() -> str {
    "A smarter cd command - zoxide without the z\n\nUsage: lope <COMMAND>\n\nCommands:\n  add     Add a directory to the database\n  query   Query the database for matching directories\n  remove  Remove a directory from the database\n  list    List all directories in the database\n  clean   Remove directories that no longer exist\n  init    Generate shell integration code\n  import  Import directories from zoxide\n  edit    Edit the database in your editor\n  help    Print this message or the help of the given subcommand(s)\n\nOptions:\n  -h, --help     Print help\n  -V, --version  Print version\n"
}

/// The help text: `add`'s.
pub fn help_add() -> str {
    "Add a directory to the database\n\nUsage: lope add [PATH]\n\nArguments:\n  [PATH]  Path to add (defaults to current directory) [default: .]\n\nOptions:\n  -h, --help     Print help\n  -V, --version  Print version\n"
}

/// The help text: `query`'s.
pub fn help_query() -> str {
    "Query the database for matching directories\n\nUsage: lope query [OPTIONS] [TERMS]...\n\nArguments:\n  [TERMS]...  Search terms (optional with --all)\n\nOptions:\n  -s, --score    Show frecency scores\n  -a, --all      Show all matches instead of just the best\n      --cwd      Match against current directory contents instead of database\n  -h, --help     Print help\n  -V, --version  Print version\n"
}

/// The help text: `remove`'s.
pub fn help_remove() -> str {
    "Remove a directory from the database\n\nUsage: lope remove <PATH>\n\nArguments:\n  <PATH>  Path to remove\n\nOptions:\n  -h, --help     Print help\n  -V, --version  Print version\n"
}

/// The help text: `list`'s.
pub fn help_list() -> str {
    "List all directories in the database\n\nUsage: lope list [OPTIONS]\n\nOptions:\n  -s, --score    Show frecency scores\n  -h, --help     Print help\n  -V, --version  Print version\n"
}

/// The help text: `clean`'s.
pub fn help_clean() -> str {
    "Remove directories that no longer exist\n\nUsage: lope clean\n\nOptions:\n  -h, --help     Print help\n  -V, --version  Print version\n"
}

/// The help text: `init`'s long form (`--help`, `help init`).
pub fn help_init_long() -> str {
    "Generate shell integration code\n\nUsage: lope init [OPTIONS] <SHELL>\n\nArguments:\n  <SHELL>\n          Shell to generate code for\n          \n          [possible values: bash, zsh, fish, fortsh, pelt]\n\nOptions:\n      --cmd <CMD>\n          Custom command name (default: g)\n          \n          [default: g]\n\n      --hook <HOOK>\n          When to update the database\n\n          Possible values:\n          - prompt: Update on every prompt\n          - pwd:    Update when directory changes\n          \n          [default: pwd]\n\n      --no-cmd\n          Only output hooks, no command aliases\n\n  -h, --help\n          Print help (see a summary with '-h')\n\n  -V, --version\n          Print version\n"
}

/// The help text: `init`'s short form (`-h`).
pub fn help_init_short() -> str {
    "Generate shell integration code\n\nUsage: lope init [OPTIONS] <SHELL>\n\nArguments:\n  <SHELL>  Shell to generate code for [possible values: bash, zsh, fish, fortsh, pelt]\n\nOptions:\n      --cmd <CMD>    Custom command name (default: g) [default: g]\n      --hook <HOOK>  When to update the database [default: pwd] [possible values: prompt, pwd]\n      --no-cmd       Only output hooks, no command aliases\n  -h, --help         Print help (see more with '--help')\n  -V, --version      Print version\n"
}

/// The help text: `import`'s.
pub fn help_import() -> str {
    "Import directories from zoxide\n\nUsage: lope import\n\nOptions:\n  -h, --help     Print help\n  -V, --version  Print version\n"
}

/// The help text: `edit`'s.
pub fn help_edit() -> str {
    "Edit the database in your editor\n\nUsage: lope edit\n\nOptions:\n  -h, --help     Print help\n  -V, --version  Print version\n"
}

/// The help text: `help`'s own.
pub fn help_help() -> str {
    "Print this message or the help of the given subcommand(s)\n\nUsage: lope help [COMMAND]...\n\nArguments:\n  [COMMAND]...  Print help for the subcommand(s)\n"
}
