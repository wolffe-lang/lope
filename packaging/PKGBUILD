# Maintainer: mfw <espadonne@outlook.com>
#
# PREPARED, NOT PUBLISHED (the track's rule 5): a release lane bumps the
# tag's digest and pushes it to the AUR on the maintainer's word.
#
# Built from source with the EXACT toolchain lope pins (wolf-toolchain.toml):
# the wolf release archive and wolf-std at its commit are sources here, by
# digest, so the build needs no network and no wolf on the builder's PATH
# (a `makedepends=('wolf-lang')` would break the day wolf-lang moved past
# the pin).
pkgname=lope
pkgver=0.1.0
pkgrel=1
pkgdesc='A frecency directory jumper in wolf: type a fragment, land where you meant'
arch=('x86_64')
url='https://github.com/wolffe-lang/lope'
license=('GPL-3.0-or-later')
depends=('glibc')
makedepends=('clang')
checkdepends=('python')
optdepends=('fzf: gi picks with fzf (a numbered menu without it)')
_wolf=0.2.33
_std=cceda63151430eac07df895fdfffddfa4a0b92c1
source=("$pkgname-$pkgver.tar.gz::https://github.com/wolffe-lang/lope/archive/refs/tags/v$pkgver.tar.gz"
        "wolf-$_wolf-x86_64-unknown-linux-gnu.tar.gz::https://github.com/wolffe-lang/wolf-lang/releases/download/v$_wolf/wolf-$_wolf-x86_64-unknown-linux-gnu.tar.gz"
        "wolf-std-$_std.tar.gz::https://github.com/wolffe-lang/wolf-std/archive/$_std.tar.gz")
sha256sums=('RELEASE-LANE-FILLS-THIS'
            '4f955e8dfe6eaafa441903eeba43c009c4ec2b45a8da09fe13431e8b12340af8'
            'RELEASE-LANE-FILLS-THIS')

build() {
    cd "$pkgname-$pkgver"
    WOLF_STD="$srcdir/wolf-std-$_std/std" \
        "$srcdir/wolf-$_wolf-x86_64-unknown-linux-gnu/wolf" build --release --deny-warnings src/lope.lu -o lope
}

check() {
    cd "$pkgname-$pkgver"
    ./lope --version
    python3 tools/probe-check ./lope
    python3 tools/oracle-check ./lope
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 lope "$pkgdir/usr/bin/lope"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 LICENSE-TRAINING-DATA "$pkgdir/usr/share/licenses/$pkgname/LICENSE-TRAINING-DATA"
}
